# Copy to .env and replace every placeholder before deployment.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
# Use a URL-safe password (letters, numbers, hyphens) for Redis.
REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_URL=redis://:replace-with-a-long-random-redis-password@redis:6379/0
REDIS_TIMEOUT_MS=1500
TICKET_CACHE_TTL_SECONDS=10
CACHE_MEMORY_MAX_ENTRIES=1000
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
CORS_ORIGIN=https://app.example.com
APP_BASE_URL=https://app.example.com
EMAIL_API_KEY=
EMAIL_FROM=AshkanBoard <no-reply@example.com>
EMAIL_PROVIDER_URL=https://api.resend.com/emails
# Enable normalized PostgreSQL runtime for all migrated domains after migrations/backfill. Legacy aggregate access is blocked in this mode.
PERSISTENCE_MODE=normalized
# PostgreSQL pool / timeout hardening
PG_POOL_MAX=10
PG_POOL_MIN=0
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=30000
PG_QUERY_TIMEOUT_MS=30000
PG_APPLICATION_NAME=ashkan-board-api
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true

# Bounded per-instance HTTP rate limiter
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_MAX_KEYS=10000
# Optional Prometheus metrics. If enabled, use a unique token of at least 32 characters.
METRICS_ENABLED=false
METRICS_TOKEN=
# Graceful shutdown deadline
SHUTDOWN_TIMEOUT_MS=10000

# Phase 42 - Enterprise OIDC / SSO
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:4000/api/auth/oidc/callback
OIDC_SCOPES=openid profile email
OIDC_ALLOWED_DOMAINS=
# Phase 43 — SCIM 2.0 provisioning
SCIM_BEARER_TOKEN=replace-with-a-random-32-plus-character-secret

# Phase 64 - webhook delivery retention
WEBHOOK_RETENTION_WORKER_ENABLED=true
WEBHOOK_RETENTION_INTERVAL_MS=3600000
WEBHOOK_RETENTION_BATCH_SIZE=500
