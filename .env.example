PORT=4000
# Generate a unique secret: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGIN=http://localhost:5173
DATA_FILE=./data/ashkan-board.json
# Optional when the frontend and API are on different origins. Leave unset for same-origin/Vite proxy development.
# VITE_API_URL=http://localhost:4000
# Optional PostgreSQL mode. Install the driver with `npm install pg`, then run `npm run db:migrate`.
DATABASE_URL=postgresql://ashkan:change-me@localhost:5432/ashkan_board
PG_SSL=false
PG_POOL_MAX=10
NODE_ENV=development
UPLOAD_DIR=./data/uploads
APP_BASE_URL=http://localhost:5173
# Optional Resend-compatible email provider; both values are required to send.
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_PROVIDER_URL=https://api.resend.com/emails

# Set to normalized to use relational PostgreSQL repositories for all migrated runtime domains.
# Run all migrations and the compatibility backfill before enabling this mode.
# In normalized mode, legacy JSONB aggregate reads and writes are blocked by the application.
PERSISTENCE_MODE=normalized

# Optional Redis cache. Without REDIS_URL, the API uses a bounded process-local cache.
# REDIS_URL=redis://:password@localhost:6379/0
REDIS_TIMEOUT_MS=1500
REDIS_CIRCUIT_FAILURE_THRESHOLD=3
REDIS_CIRCUIT_COOLDOWN_MS=15000
TICKET_CACHE_TTL_SECONDS=10
CACHE_MEMORY_MAX_ENTRIES=1000

# PostgreSQL backup and restore
BACKUP_DIR=./backups
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore
# Set only for an explicitly approved restore operation
# BACKUP_PATH=./backups/ashkan-...
# RESTORE_DATABASE_URL=postgresql://...
# RESTORE_CONFIRM=YES
# RESTORE_UPLOAD_DIR=./data/uploads-restored
# Enterprise security / MFA
# TOTP secrets are encrypted at rest using a key derived from JWT_SECRET.
MFA_ISSUER=AshkanBoard

# Phase 42 - Enterprise OIDC / SSO
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:4000/api/auth/oidc/callback
OIDC_SCOPES=openid profile email
OIDC_ALLOWED_DOMAINS=
# Phase 43 — SCIM 2.0 provisioning
SCIM_BEARER_TOKEN=replace-with-a-random-32-plus-character-secret

# Phase 64 - webhook delivery retention
WEBHOOK_RETENTION_WORKER_ENABLED=true
WEBHOOK_RETENTION_INTERVAL_MS=3600000
WEBHOOK_RETENTION_BATCH_SIZE=500
